# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Add your public HTTPS origin here in production, e.g. https://api.shoer.lk
DJANGO_CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Telegram bot from @BotFather
TELEGRAM_BOT_TOKEN=
# Chat or group id that receives new order alerts (optional)
TELEGRAM_ADMIN_CHAT_ID=
# Random secret for the bot webhook (the setup script generates one)
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS URL of the Mini App. Defaults to https://<first allowed host>/
WEBAPP_URL=
# How long a Telegram initData stays valid, seconds
TELEGRAM_INIT_DATA_MAX_AGE=86400
# Allows opening the app in a normal browser while DEBUG is on. Keep false in production.
TELEGRAM_DEV_AUTH=true

# Path to the built frontend (dist). Set on the server to serve the React app from Django.
FRONTEND_DIST=

# Shop
SHIPPING_FEE=4.99
TIME_ZONE=Asia/Tashkent

# PostgreSQL (leave POSTGRES_DB empty to use SQLite; install psycopg[binary] for Postgres)
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
